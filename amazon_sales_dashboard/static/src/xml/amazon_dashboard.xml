<?xml version="1.8" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amazon_sales_dashboard.AmazonDashboardTemplate">
        <div class="amazon-dashboard-container p-4">

            <!-- Top Header & Global Actions Bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom dashboard-header">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="fa fa-amazon text-warning"></i>
                        <t t-if="state.isAllDashboard">Amazon All Sales &amp; Refunds Dashboard</t>
                        <t t-else="">Amazon Sales &amp; Refund Dashboard</t>
                    </h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted fs-6">
                            <t t-if="state.isAllDashboard">All Historical Data across all past file uploads</t>
                            <t t-else="">Latest Upload File Dashboard</t>
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1 small">
                            <i class="fa fa-database me-1"></i> <t t-esc="state.kpis.latest_batch_id || 'Latest Upload'"/>
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <t t-if="!state.isAllDashboard">
                        <button class="btn btn-outline-danger btn-sm rounded-pill shadow-sm" t-on-click="onClearDashboardView" title="Clear current dashboard view (Database records remain safe)">
                            <i class="fa fa-eraser me-1"></i> Clear View
                        </button>
                    </t>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill shadow-sm" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"></i> Refresh
                    </button>
                    <button class="btn btn-gradient-upload btn-md rounded-pill shadow-sm" t-on-click="onUploadCsv">
                        <i class="fa fa-upload me-1"></i> Upload Excel/CSV File
                    </button>
                </div>
            </div>

            <!-- KPI Metric Summary Cards (4 Cards) -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Shipments -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="kpi-card kpi-blue p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden cursor-pointer" t-on-click="() => this.onSelectKpiCard('Shipment', 'all')" title="Click to filter all shipments">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Total Shipments</span>
                            <div class="kpi-icon-badge bg-blue-subtle text-primary rounded-circle">
                                <i class="fa fa-truck"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.total_shipments_count || 0"/> Records
                        </div>
                        <div class="d-flex justify-content-between align-items-center small fw-semibold">
                            <span class="text-primary"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_shipment_amount || 0"/></span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill" t-on-click.stop="() => this.onSelectKpiCard('Shipment', 'pending')">
                                <t t-esc="state.kpis.pending_shipments_count || 0"/> Pending
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Refunds -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="kpi-card kpi-amber p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden cursor-pointer" t-on-click="() => this.onSelectKpiCard('Refund', 'all')" title="Click to filter all refunds">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Total Refunds</span>
                            <div class="kpi-icon-badge bg-warning-subtle text-warning rounded-circle">
                                <i class="fa fa-undo"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.total_refunds_count || 0"/> Records
                        </div>
                        <div class="d-flex justify-content-between align-items-center small fw-semibold">
                            <span class="text-warning"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_refund_amount || 0"/></span>
                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill" t-on-click.stop="() => this.onSelectKpiCard('Refund', 'pending')">
                                <t t-esc="state.kpis.pending_refunds_count || 0"/> Pending
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Cancels -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="kpi-card kpi-purple p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden cursor-pointer" t-on-click="() => this.onSelectKpiCard('Cancel', 'all')" title="Click to filter all cancellations">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Total Cancels</span>
                            <div class="kpi-icon-badge bg-danger-subtle text-danger rounded-circle">
                                <i class="fa fa-times-circle"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.total_cancels_count || 0"/> Records
                        </div>
                        <div class="d-flex justify-content-between align-items-center small fw-semibold">
                            <span class="text-danger"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_cancel_amount || 0"/></span>
                            <span class="badge bg-danger-subtle text-danger rounded-pill" t-on-click.stop="() => this.onSelectKpiCard('Cancel', 'pending')">
                                <t t-esc="state.kpis.pending_cancels_count || 0"/> Pending
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Free Replacements -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="kpi-card kpi-emerald p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden cursor-pointer" t-on-click="() => this.onSelectKpiCard('FreeReplacement', 'all')" title="Click to filter all replacements">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Free Replacements</span>
                            <div class="kpi-icon-badge bg-info-subtle text-info rounded-circle">
                                <i class="fa fa-refresh"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.total_replacements_count || 0"/> Records
                        </div>
                        <div class="d-flex justify-content-between align-items-center small fw-semibold">
                            <span class="text-info"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_replacement_amount || 0"/></span>
                            <span class="badge bg-info-subtle text-info rounded-pill" t-on-click.stop="() => this.onSelectKpiCard('FreeReplacement', 'pending')">
                                <t t-esc="state.kpis.pending_replacements_count || 0"/> Pending
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Full Width Unified Table Panel -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden panel-card">
                
                <!-- Table Header Controls: Type Pills, Status Filter, Search & Bulk Convert Action -->
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                    
                    <!-- Left: Transaction Type Pills -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm rounded-pill p-1 bg-light border" role="group">
                            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold" t-att-class="state.typeFilter === 'All' ? 'btn-primary' : 'btn-light text-muted'" t-on-click="() => this.onTypeFilterChange('All')">
                                All (<t t-esc="state.allRecords.length"/>)
                            </button>
                            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold" t-att-class="state.typeFilter === 'Shipment' ? 'btn-primary' : 'btn-light text-muted'" t-on-click="() => this.onTypeFilterChange('Shipment')">
                                <i class="fa fa-truck me-1"></i> Shipment
                            </button>
                            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold" t-att-class="state.typeFilter === 'Refund' ? 'btn-warning text-dark' : 'btn-light text-muted'" t-on-click="() => this.onTypeFilterChange('Refund')">
                                <i class="fa fa-undo me-1"></i> Refund
                            </button>
                            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold" t-att-class="state.typeFilter === 'Cancel' ? 'btn-danger' : 'btn-light text-muted'" t-on-click="() => this.onTypeFilterChange('Cancel')">
                                <i class="fa fa-times-circle me-1"></i> Cancel
                            </button>
                            <button type="button" class="btn rounded-pill px-3 py-1 fw-semibold" t-att-class="state.typeFilter === 'FreeReplacement' ? 'btn-info text-white' : 'btn-light text-muted'" t-on-click="() => this.onTypeFilterChange('FreeReplacement')">
                                <i class="fa fa-refresh me-1"></i> Replacement
                            </button>
                        </div>
                    </div>

                    <!-- Right: Search Bar, Status Filter & Convert Selected Button -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        
                        <!-- Status Dropdown Filter -->
                        <div class="d-flex align-items-center gap-1">
                            <span class="small text-muted fw-semibold">Status:</span>
                            <select class="form-select form-select-sm rounded-pill border-secondary-subtle px-3" t-on-change="onStatusFilterChange">
                                <option value="pending" t-att-selected="state.statusFilter === 'pending'">Pending (Default)</option>
                                <option value="all" t-att-selected="state.statusFilter === 'all'">All Statuses</option>
                                <option value="so_created" t-att-selected="state.statusFilter === 'so_created'">SO Created</option>
                                <option value="refund_created" t-att-selected="state.statusFilter === 'refund_created'">Refund Created</option>
                                <option value="cancelled" t-att-selected="state.statusFilter === 'cancelled'">Cancelled</option>
                                <option value="replacement_created" t-att-selected="state.statusFilter === 'replacement_created'">Replacement Created</option>
                                <option value="error" t-att-selected="state.statusFilter === 'error'">Error</option>
                            </select>
                        </div>

                        <!-- Search Bar -->
                        <div class="input-group input-group-sm search-box" style="width: 230px;">
                            <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0 bg-light" placeholder="Search Order ID, SKU..." t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
                        </div>

                        <!-- Convert Selected Action Button -->
                        <button class="btn btn-success btn-sm rounded-pill px-3 shadow-xs d-flex align-items-center gap-1" t-on-click="onProcessSelected">
                            <i class="fa fa-check-square-o"></i>
                            <span>Convert Selected</span>
                            <t t-if="state.selectedIds.size > 0">
                                <span class="badge bg-white text-success rounded-circle ms-1"><t t-esc="state.selectedIds.size"/></span>
                            </t>
                        </button>
                    </div>
                </div>

                <!-- Full Width Dynamic Table -->
                <div class="card-body p-0 table-responsive dashboard-table-wrapper">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <input type="checkbox" class="form-check-input" t-att-checked="state.isAllSelected" t-on-change="toggleSelectAll"/>
                                </th>
                                <th>Type</th>
                                <th>Order ID</th>
                                <th>Invoice / Credit Note No</th>
                                <th>Date</th>
                                <th>SKU</th>
                                <th>Qty</th>
                                <th>Price Excl. Tax</th>
                                <th>Invoice Total</th>
                                <th>Ship To</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.filteredRecords.length === 0">
                                <tr>
                                    <td colspan="12" class="text-center py-5 text-muted">
                                        <i class="fa fa-folder-open-o fs-2 mb-2 d-block text-secondary"></i>
                                        <t t-if="state.isCleared">
                                            Dashboard view cleared. Click <b>Upload Excel/CSV File</b> or <b>Refresh</b> to reload data.
                                        </t>
                                        <t t-else="">
                                            No transaction records match the current filters.
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="state.filteredRecords" t-as="rec" t-key="rec.id">
                                <tr t-att-class="state.selectedIds.has(rec.id) ? 'table-primary-subtle' : ''">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" t-att-checked="state.selectedIds.has(rec.id)" t-on-change="() => this.toggleSelectRecord(rec.id)"/>
                                    </td>
                                    <td>
                                        <t t-if="rec.transaction_type === 'Shipment'">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                                                <i class="fa fa-truck me-1"></i> Shipment
                                            </span>
                                        </t>
                                        <t t-elif="rec.transaction_type === 'Refund'">
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1">
                                                <i class="fa fa-undo me-1"></i> Refund
                                            </span>
                                        </t>
                                        <t t-elif="rec.transaction_type === 'Cancel'">
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                                <i class="fa fa-times-circle me-1"></i> Cancel
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1">
                                                <i class="fa fa-refresh me-1"></i> Replacement
                                            </span>
                                        </t>
                                    </td>
                                    <td class="fw-bold text-dark"><t t-esc="rec.order_id"/></td>
                                    <td>
                                        <t t-if="rec.credit_note_no">
                                            <t t-esc="rec.credit_note_no"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="rec.invoice_number || 'N/A'"/>
                                        </t>
                                    </td>
                                    <td class="small text-muted"><t t-esc="rec.order_date"/></td>
                                    <td><span class="badge bg-light text-dark border fw-mono"><t t-esc="rec.sku"/></span></td>
                                    <td><t t-esc="rec.quantity"/></td>
                                    <td class="small text-muted"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="rec.tax_exclusive_gross"/></td>
                                    <td class="fw-semibold"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="rec.invoice_amount"/></td>
                                    <td class="small text-muted"><t t-esc="rec.ship_to"/></td>
                                    <td>
                                        <t t-if="rec.state === 'draft'">
                                            <span class="badge bg-info text-dark rounded-pill px-2 py-1">Pending</span>
                                        </t>
                                        <t t-elif="rec.state === 'so_created'">
                                            <span class="badge bg-success rounded-pill px-2 py-1">
                                                <i class="fa fa-check me-1"></i> SO Created
                                            </span>
                                        </t>
                                        <t t-elif="rec.state === 'refund_created'">
                                            <span class="badge bg-success rounded-pill px-2 py-1">
                                                <i class="fa fa-check me-1"></i> Refund Created
                                            </span>
                                        </t>
                                        <t t-elif="rec.state === 'cancelled'">
                                            <span class="badge bg-secondary rounded-pill px-2 py-1">
                                                <i class="fa fa-times me-1"></i> Cancelled
                                            </span>
                                        </t>
                                        <t t-elif="rec.state === 'replacement_created'">
                                            <span class="badge bg-primary rounded-pill px-2 py-1">
                                                <i class="fa fa-refresh me-1"></i> Replacement
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-danger rounded-pill px-2 py-1 cursor-pointer" t-att-title="rec.error_message || 'Error occurred during creation'" t-on-click="() => this.onInspectRecord(rec.id)">
                                                <i class="fa fa-exclamation-triangle me-1"></i> Error
                                            </span>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <t t-if="rec.state === 'draft' or rec.state === 'error'">
                                                <t t-if="rec.transaction_type === 'Shipment'">
                                                    <button class="btn btn-sm btn-primary rounded-pill px-2 py-1 me-1 shadow-xs" t-on-click="() => this.onCreateSaleOrder(rec.id)" title="Create Sale Order + Delivery (+ Invoice if present)">
                                                        <i class="fa fa-plus-circle me-1"></i> Create SO
                                                    </button>
                                                </t>
                                                <t t-elif="rec.transaction_type === 'Refund'">
                                                    <button class="btn btn-sm btn-warning text-dark rounded-pill px-2 py-1 me-1 shadow-xs" t-on-click="() => this.onCreateRefund(rec.id)" title="Create Refund Credit Note">
                                                        <i class="fa fa-undo me-1"></i> Refund
                                                    </button>
                                                </t>
                                                <t t-elif="rec.transaction_type === 'Cancel'">
                                                    <button class="btn btn-sm btn-danger rounded-pill px-2 py-1 me-1 shadow-xs" t-on-click="() => this.onProcessCancel(rec.id)" title="Cancel Order + Return Delivery + Reverse Invoice">
                                                        <i class="fa fa-times-circle me-1"></i> Cancel
                                                    </button>
                                                </t>
                                                <t t-elif="rec.transaction_type === 'FreeReplacement'">
                                                    <button class="btn btn-sm btn-info text-white rounded-pill px-2 py-1 me-1 shadow-xs" t-on-click="() => this.onCreateFreeReplacement(rec.id)" title="Create Free Replacement Sale Order">
                                                        <i class="fa fa-refresh me-1"></i> Replace
                                                    </button>
                                                </t>
                                            </t>
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 shadow-xs" t-on-click="() => this.onInspectRecord(rec.id)" title="Inspect All Details">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
