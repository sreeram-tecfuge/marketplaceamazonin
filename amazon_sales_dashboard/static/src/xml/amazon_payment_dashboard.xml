<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amazon_sales_dashboard.AmazonPaymentDashboardTemplate">
        <div class="amazon-payment-dashboard-container p-4">

            <!-- Top Header & Global Actions Bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom dashboard-header">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="fa fa-credit-card text-success"></i>
                        <span>
                            <t t-if="state.isAllDashboard">All Historical Payment Settlements</t>
                            <t t-else="">Amazon Payment &amp; Settlement Dashboard</t>
                        </span>
                    </h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted fs-6">
                            <t t-if="state.isAllDashboard">All Historical Settlement Data across all past imported files</t>
                            <t t-else="">Settlement Payouts, Order Fee Breakdown &amp; Financial Reconciliation</t>
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                            <i class="fa fa-database me-1"></i> <t t-esc="state.isAllDashboard ? 'All Records' : (state.kpis.latest_batch_id || 'Latest Batch')"/>
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <t t-if="!state.isAllDashboard">
                        <button class="btn btn-outline-primary btn-sm rounded-pill shadow-sm" t-on-click="onToggleAllDashboard" title="Switch to view all historical payment settlement records">
                            <i class="fa fa-database me-1"></i> View All Payment Data
                        </button>
                    </t>
                    <t t-else="">
                        <button class="btn btn-outline-success btn-sm rounded-pill shadow-sm" t-on-click="onToggleAllDashboard" title="Switch to view latest batch upload only">
                            <i class="fa fa-filter me-1"></i> View Latest Batch Only
                        </button>
                    </t>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill shadow-sm" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"></i> Refresh
                    </button>
                    <button class="btn btn-gradient-upload btn-md rounded-pill shadow-sm" t-on-click="onUploadPaymentCsv">
                        <i class="fa fa-upload me-1"></i> Upload Payment Excel/CSV
                    </button>
                </div>
            </div>



            <!-- KPI Cards for All Amount Descriptions -->
            <t t-if="state.kpis.field_totals &amp;&amp; state.kpis.field_totals.length &gt; 0">
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <i class="fa fa-calculator text-primary"></i>
                            <span>All Amount Description Totals</span>
                        </h6>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                            <t t-esc="state.kpis.field_totals.length"/> Field Categories
                        </span>
                    </div>
                    <div class="row g-3">
                        <t t-foreach="state.kpis.field_totals" t-as="ft" t-key="ft.description">
                            <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                                <div class="kpi-mini-card p-3 rounded-4 shadow-sm bg-white border-0 h-100 d-flex flex-column justify-content-between position-relative overflow-hidden">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="text-uppercase fw-semibold text-muted small text-truncate me-1" t-att-title="ft.description" style="font-size: 0.75rem; letter-spacing: 0.03em;">
                                            <t t-esc="ft.description"/>
                                        </span>
                                        <div class="kpi-mini-icon rounded-circle d-flex align-items-center justify-content-center" t-att-class="ft.amount &lt; 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'" style="width: 26px; height: 26px; font-size: 0.75rem; flex-shrink: 0;">
                                            <i t-att-class="ft.amount &lt; 0 ? 'fa fa-arrow-down' : 'fa fa-arrow-up'"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="h5 fw-bold mb-0 font-monospace" t-att-class="ft.amount &lt; 0 ? 'text-danger' : 'text-success'">
                                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ft.amount"/>
                                        </div>
                                        <span class="small text-muted fw-semibold" style="font-size: 0.72rem;">Total Amount</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Orders Settlement Overview Table (Full Width) -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                    <i class="fa fa-list-alt text-success"></i> Orders Settlement Overview
                                </h5>
                                <span class="text-muted small">Overview of settlement orders with direct breakdown access</span>
                            </div>
                            <!-- Search Bar -->
                            <div class="input-group input-group-sm search-box" style="width: 260px;">
                                <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0 bg-light" placeholder="Search Order ID..." t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
                            </div>
                        </div>

                        <div class="card-body p-0 table-responsive orders-list-scroll-container" style="max-height: 540px; overflow-y: auto !important; display: block !important;">
                            <table class="table table-hover align-middle mb-0 text-nowrap" style="border-collapse: separate !important; border-spacing: 0 !important; width: 100%;">
                                <thead class="table-light text-uppercase small text-muted sticky-top">
                                    <tr>
                                        <th class="ps-4 py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Order ID</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Posted Date</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Reconciliation Status</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Principal Sales</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Amazon Fees</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Tax Amount</th>
                                        <th class="py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Net Payout</th>
                                        <th class="text-end pe-4 py-3" style="position: sticky; top: 0; z-index: 10; background-color: #f8f9fa !important; border-bottom: 2px solid #dee2e6;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.filteredOrders.length === 0">
                                        <tr>
                                            <td colspan="8" class="text-center py-5 text-muted">
                                                <i class="fa fa-folder-open-o fs-2 mb-2 d-block text-secondary"></i>
                                                No payment order records match your search query.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.filteredOrders" t-as="ord" t-key="ord.order_id">
                                        <tr t-att-class="state.selectedOrderId === ord.order_id ? 'table-success-subtle border-start border-success border-4' : ''" class="cursor-pointer">
                                            <td class="ps-4 fw-bold text-dark font-monospace"><t t-esc="ord.order_id"/></td>
                                            <td class="small text-muted"><t t-esc="ord.posted_date"/></td>
                                            <td>
                                                <t t-if="ord.is_processed">
                                                    <span class="badge bg-success text-white rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1 shadow-sm" title="Settlement Reconciliation Complete">
                                                        <i class="fa fa-check-circle"></i> Reconciled
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1" title="Pending Settlement Reconciliation">
                                                        <i class="fa fa-clock-o"></i> Pending
                                                    </span>
                                                </t>
                                            </td>
                                            <td class="small font-monospace text-primary fw-semibold"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.principal"/></td>
                                            <td class="small font-monospace text-danger"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.fees"/></td>
                                            <td class="small font-monospace text-muted"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.tax"/></td>
                                            <td class="fw-bold font-monospace text-success"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.total_amount"/></td>
                                            <td class="text-end pe-4">
                                                <t t-if="!ord.is_processed">
                                                    <button class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" t-on-click.stop="() => this.onProcessFullSettlement(ord.order_id)" title="Process Customer Payment &amp; Segregated Fee Clearing">
                                                        <i class="fa fa-cogs"></i> Process Settlement
                                                    </button>
                                                </t>
                                                <t t-else="">
                                                    <t t-if="ord.payment_id">
                                                        <button class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm ms-1" t-on-click.stop="() => this.onOpenPayment(ord.payment_id)" title="View Created Customer Payment">
                                                            <i class="fa fa-credit-card"></i> Payment
                                                        </button>
                                                    </t>
                                                    <t t-if="ord.move_id">
                                                        <button class="btn btn-sm btn-outline-info rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm ms-1" t-on-click.stop="() => this.onOpenJournalEntry(ord.move_id)" title="View Created Transfer Journal Entry">
                                                            <i class="fa fa-book"></i> Journal Entry
                                                        </button>
                                                    </t>
                                                    <t t-if="ord.vendor_bill_id">
                                                        <button class="btn btn-sm btn-outline-warning text-dark rounded-pill px-2.5 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm ms-1" t-on-click.stop="() => this.onOpenVendorBill(ord.vendor_bill_id)" title="View Created Amazon Fee Vendor Bill">
                                                            <i class="fa fa-file-text-o"></i> Vendor Bill
                                                        </button>
                                                    </t>
                                                </t>
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm ms-1" t-on-click.stop="() => this.onOpenBreakdownWizard(ord.order_id)" title="View Order Settlement Breakdown in Wizard">
                                                    <i class="fa fa-table"></i> Breakdown
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 ms-1 shadow-sm" t-on-click.stop="() => this.onInspectOrder(ord.order_id)" title="Inspect Settlement Raw Lines">
                                                    <i class="fa fa-eye"></i> Details
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settlement Breakdown Modal Wizard Popup -->
            <t t-if="state.showBreakdownModal">
                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.55); z-index: 1055;">
                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                            
                            <!-- Modal Header -->
                            <div class="modal-header bg-dark text-white py-3 px-4">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-table text-success fs-5"></i>
                                    <h5 class="modal-title fw-bold mb-0 text-white">Order Settlement Breakdown</h5>
                                    <t t-if="state.selectedOrder">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 font-monospace ms-2 fs-6">
                                            <t t-esc="state.selectedOrder.order_id"/>
                                        </span>
                                    </t>
                                </div>
                                <button type="button" class="btn-close btn-close-white" t-on-click="onCloseBreakdownWizard" aria-label="Close"></button>
                            </div>

                            <!-- Modal Body -->
                            <div class="modal-body p-4 bg-light">
                                <!-- Order Selection & Summary Card -->
                                <div class="mb-3 bg-white p-3 rounded-3 border shadow-sm d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 260px;">
                                        <label class="form-label small fw-bold text-muted mb-0 text-nowrap"><i class="fa fa-filter me-1 text-primary"></i>Select Order ID:</label>
                                        <select class="form-select form-select-sm rounded-pill border-secondary-subtle font-monospace fw-bold" t-on-change="onOrderSelectChange">
                                            <t t-foreach="state.allOrderIds" t-as="oid" t-key="oid">
                                                <option t-att-value="oid" t-att-selected="state.selectedOrderId === oid">
                                                    <t t-esc="oid"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <t t-if="state.selectedOrder">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 small fw-semibold">
                                                <i class="fa fa-list-ol me-1"></i> <t t-esc="state.selectedOrder.records_count"/> Settlement Lines
                                            </span>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 small fw-semibold">
                                                <i class="fa fa-calendar me-1"></i> <t t-esc="state.selectedOrder.posted_date || 'N/A'"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>

                                <!-- Breakdown Pivot Table -->
                                <t t-if="state.selectedOrder">
                                    <div class="table-responsive border rounded-3 bg-white shadow-sm breakdown-table-scroll-container" style="max-height: 400px; overflow-y: auto !important; display: block !important;">
                                        <table class="table table-hover table-striped align-middle mb-0" style="border-collapse: separate !important; border-spacing: 0 !important; width: 100%;">
                                            <thead class="table-dark text-uppercase small sticky-top">
                                                <tr>
                                                    <th class="ps-4 py-3 text-white fw-bold" style="position: sticky; top: 0; z-index: 10; background-color: #212529 !important; color: #ffffff !important; border-bottom: 2px solid #495057;">ROW LABELS</th>
                                                    <th class="text-end pe-4 py-3 text-white fw-bold" style="position: sticky; top: 0; z-index: 10; background-color: #212529 !important; color: #ffffff !important; border-bottom: 2px solid #495057;">SUM OF AMOUNT</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="state.selectedOrder.breakdown" t-as="b" t-key="b.description">
                                                    <tr>
                                                        <td class="ps-4 fw-bold text-dark py-2.5" style="color: #1e293b !important; font-size: 0.95rem;">
                                                            <t t-esc="b.description"/>
                                                        </td>
                                                        <td class="text-end pe-4 font-monospace fw-bold py-2.5" t-att-class="b.amount &lt; 0 ? 'text-danger' : 'text-dark'" t-att-style="b.amount &lt; 0 ? 'color: #dc2626 !important;' : 'color: #0f172a !important;'">
                                                            <t t-esc="b.amount"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                            <tfoot class="table-secondary border-top border-2 sticky-bottom">
                                                <tr class="fw-bold fs-6">
                                                    <td class="ps-4 py-3 text-dark fw-bold" style="position: sticky; bottom: 0; z-index: 10; background-color: #e2e3e5 !important; color: #0f172a !important; border-top: 2px solid #ced4da;">Grand Total</td>
                                                    <td class="text-end pe-4 py-3 font-monospace text-success fs-5 fw-bold" style="position: sticky; bottom: 0; z-index: 10; background-color: #e2e3e5 !important; color: #059669 !important; border-top: 2px solid #ced4da;">
                                                        <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.selectedOrder.total_amount"/>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center py-5 text-muted bg-white rounded-3 border">
                                        <i class="fa fa-info-circle fs-2 text-muted mb-2 d-block"></i>
                                        <span>No settlement breakdown data available for this order.</span>
                                    </div>
                                </t>
                            </div>

                            <!-- Modal Footer with Action Buttons -->
                            <div class="modal-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <t t-if="state.selectedOrder &amp;&amp; !state.selectedOrder.is_processed">
                                        <button class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm" t-on-click="() => this.onProcessFullSettlement(state.selectedOrder ? state.selectedOrder.order_id : null)" title="Process Customer Payment &amp; Segregated Fee Clearing">
                                            <i class="fa fa-cogs me-1"></i> Process Payment &amp; Fee Settlement
                                        </button>
                                    </t>
                                    <t t-if="state.selectedOrder &amp;&amp; state.selectedOrder.is_processed">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold">
                                            <i class="fa fa-check-circle me-1"></i> Reconciled
                                        </span>
                                        <t t-if="state.selectedOrder.payment_id">
                                            <button class="btn btn-outline-success rounded-pill px-3 py-1.5 fw-semibold shadow-sm ms-1" t-on-click="() => this.onOpenPayment(state.selectedOrder.payment_id)">
                                                <i class="fa fa-credit-card me-1"></i> View Payment
                                            </button>
                                        </t>
                                        <t t-if="state.selectedOrder.move_id">
                                            <button class="btn btn-outline-info rounded-pill px-3 py-1.5 fw-semibold shadow-sm ms-1" t-on-click="() => this.onOpenJournalEntry(state.selectedOrder.move_id)">
                                                <i class="fa fa-book me-1"></i> View Journal Entry
                                            </button>
                                        </t>
                                        <t t-if="state.selectedOrder.vendor_bill_id">
                                            <button class="btn btn-outline-warning text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm ms-1" t-on-click="() => this.onOpenVendorBill(state.selectedOrder.vendor_bill_id)">
                                                <i class="fa fa-file-text-o me-1"></i> View Vendor Bill
                                            </button>
                                        </t>
                                    </t>
                                </div>
                                <button type="button" class="btn btn-secondary rounded-pill px-4 py-2" t-on-click="onCloseBreakdownWizard">
                                    Close
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
