<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="amazon_sales_dashboard.AmazonPaymentDashboardTemplate">
        <div class="amazon-payment-dashboard-container p-4">

            <!-- Top Header & Global Actions Bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom dashboard-header">
                <div>
                    <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="fa fa-credit-card text-success"></i>
                        <span>Amazon Payment &amp; Settlement Dashboard</span>
                    </h2>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted fs-6">Settlement Payouts, Order Fee Breakdown &amp; Financial Reconciliation</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                            <i class="fa fa-database me-1"></i> <t t-esc="state.kpis.latest_batch_id || 'Latest Batch'"/>
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill shadow-sm" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"></i> Refresh
                    </button>
                    <button class="btn btn-gradient-upload btn-md rounded-pill shadow-sm" t-on-click="onUploadPaymentCsv">
                        <i class="fa fa-upload me-1"></i> Upload Payment Excel/CSV
                    </button>
                </div>
            </div>

            <!-- KPI Metric Summary Cards (5 Cards) -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Total Net Settlement Payout -->
                <div class="col-12 col-sm-6 col-xl-2-4">
                    <div class="kpi-card kpi-emerald p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Net Payout</span>
                            <div class="kpi-icon-badge bg-success-subtle text-success rounded-circle">
                                <i class="fa fa-money"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-success">
                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_payout || 0"/>
                        </div>
                        <div class="small text-muted fw-semibold">
                            <span>Total Settlement Amount</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Gross Principal Sales -->
                <div class="col-12 col-sm-6 col-xl-2-4">
                    <div class="kpi-card kpi-blue p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Principal Sales</span>
                            <div class="kpi-icon-badge bg-primary-subtle text-primary rounded-circle">
                                <i class="fa fa-shopping-cart"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_principal || 0"/>
                        </div>
                        <div class="small text-muted fw-semibold">
                            <span class="text-primary"><t t-esc="state.kpis.total_orders_count || 0"/> Total Orders</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Product Tax -->
                <div class="col-12 col-sm-6 col-xl-2-4">
                    <div class="kpi-card kpi-purple p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Product Tax</span>
                            <div class="kpi-icon-badge bg-info-subtle text-info rounded-circle">
                                <i class="fa fa-percent"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_product_tax || 0"/>
                        </div>
                        <div class="small text-muted fw-semibold">
                            <span>GST Tax Collected</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Amazon Fees & Charges -->
                <div class="col-12 col-sm-6 col-xl-2-4">
                    <div class="kpi-card kpi-amber p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">Amazon Fees</span>
                            <div class="kpi-icon-badge bg-warning-subtle text-warning rounded-circle">
                                <i class="fa fa-tags"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-danger">
                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_amazon_fees || 0"/>
                        </div>
                        <div class="small text-muted fw-semibold">
                            <span>Commission &amp; Logistics</span>
                        </div>
                    </div>
                </div>

                <!-- Card 5: TCS / TDS Taxes -->
                <div class="col-12 col-sm-6 col-xl-2-4">
                    <div class="kpi-card kpi-rose p-3 rounded-4 shadow-sm border-0 position-relative overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-uppercase fw-semibold tracking-wider text-muted small">TCS / TDS Taxes</span>
                            <div class="kpi-icon-badge bg-danger-subtle text-danger rounded-circle">
                                <i class="fa fa-university"></i>
                            </div>
                        </div>
                        <div class="h3 fw-bold mb-1 text-dark">
                            <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.kpis.total_withheld_taxes || 0"/>
                        </div>
                        <div class="small text-muted fw-semibold">
                            <span>Withheld Statutory Taxes</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Two Column Split View: Left Order Breakdown Panel (Pivot Style like Image) | Right Orders Overview List -->
            <div class="row g-4">
                
                <!-- Left Column: Selected Order Settlement Breakdown (Matching Excel Image Layout) -->
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-table text-primary fs-5"></i>
                                <h5 class="fw-bold mb-0 text-dark">Order Settlement Breakdown</h5>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1" t-on-click="onCreateJournalEntry" title="Create Journal Entry for Selected Order">
                                    <i class="fa fa-book me-1"></i> Journal Entry
                                </button>
                                <button class="btn btn-outline-success btn-sm rounded-pill px-2 py-1 ms-1" t-on-click="onCreatePayment" title="Create Payment Entry for Selected Order">
                                    <i class="fa fa-check me-1"></i> Payment
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <!-- Order Picker / Search Bar -->
                            <div class="mb-3 bg-light p-2 rounded-3 border">
                                <label class="form-label small fw-bold text-muted mb-1">Select / Filter Order ID:</label>
                                <select class="form-select form-select-sm rounded-pill border-secondary-subtle" t-on-change="onOrderSelectChange">
                                    <option value="">-- Choose Order ID --</option>
                                    <t t-foreach="state.allOrderIds" t-as="oid" t-key="oid">
                                        <option t-att-value="oid" t-att-selected="state.selectedOrderId === oid">
                                            <t t-esc="oid"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <t t-if="state.selectedOrder">
                                <div class="p-2 mb-2 bg-primary-subtle text-primary border border-primary-subtle rounded-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold me-2"><i class="fa fa-tag"></i> Order ID:</span>
                                        <span class="fw-bold"><t t-esc="state.selectedOrder.order_id"/></span>
                                    </div>
                                    <span class="badge bg-primary rounded-pill"><t t-esc="state.selectedOrder.records_count"/> Lines</span>
                                </div>

                                <!-- Financial Breakdown Table (Exactly formatted like user's excel image) -->
                                <div class="table-responsive border rounded-3 overflow-hidden mt-3">
                                    <table class="table table-hover table-striped align-middle mb-0">
                                        <thead class="table-dark text-uppercase small">
                                            <tr>
                                                <th class="ps-3 py-2">Row Labels</th>
                                                <th class="text-end pe-3 py-2">Sum of amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.selectedOrder.breakdown" t-as="b" t-key="b.description">
                                                <tr>
                                                    <td class="ps-3 fw-semibold text-secondary">
                                                        <t t-esc="b.description"/>
                                                    </td>
                                                    <td class="text-end pe-3 font-monospace fw-bold" t-att-class="b.amount &lt; 0 ? 'text-danger' : 'text-dark'">
                                                        <t t-esc="b.amount"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot class="table-secondary border-top border-2">
                                            <tr class="fw-bold fs-6">
                                                <td class="ps-3 py-2 text-dark">Grand Total</td>
                                                <td class="text-end pe-3 py-2 font-monospace text-success fs-5">
                                                    <t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="state.selectedOrder.total_amount"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="text-center py-5 text-muted">
                                    <i class="fa fa-search fs-1 mb-2 text-secondary d-block"></i>
                                    <span>Please select an order from the list or dropdown to view its detailed payment fee breakdown.</span>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Orders Summary List Table -->
                <div class="col-12 col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <i class="fa fa-list-alt text-success"></i> Orders Settlement Overview
                            </h5>
                            <!-- Search Bar -->
                            <div class="input-group input-group-sm search-box" style="width: 220px;">
                                <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0 bg-light" placeholder="Search Order ID..." t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
                            </div>
                        </div>

                        <div class="card-body p-0 table-responsive">
                            <table class="table table-hover align-middle mb-0 text-nowrap">
                                <thead class="table-light text-uppercase small text-muted">
                                    <tr>
                                        <th class="ps-3">Order ID</th>
                                        <th>Date</th>
                                        <th>Principal</th>
                                        <th>Fees</th>
                                        <th>Tax</th>
                                        <th>Net Amount</th>
                                        <th class="text-end pe-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.filteredOrders.length === 0">
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="fa fa-folder-open-o fs-2 mb-2 d-block text-secondary"></i>
                                                No payment order records match your search query.
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.filteredOrders" t-as="ord" t-key="ord.order_id">
                                        <tr t-att-class="state.selectedOrderId === ord.order_id ? 'table-success-subtle border-start border-success border-4' : ''" class="cursor-pointer" t-on-click="() => this.onSelectOrder(ord.order_id)">
                                            <td class="ps-3 fw-bold text-dark"><t t-esc="ord.order_id"/></td>
                                            <td class="small text-muted"><t t-esc="ord.posted_date"/></td>
                                            <td class="small font-monospace text-primary fw-semibold"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.principal"/></td>
                                            <td class="small font-monospace text-danger"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.fees"/></td>
                                            <td class="small font-monospace text-muted"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.tax"/></td>
                                            <td class="fw-bold font-monospace text-success"><t t-esc="state.kpis.currency_symbol || '₹'"/> <t t-esc="ord.total_amount"/></td>
                                            <td class="text-end pe-3">
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" t-on-click.stop="() => this.onInspectOrder(ord.order_id)" title="Inspect All Settlement Lines">
                                                    <i class="fa fa-eye"></i> Details
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </t>
</templates>
