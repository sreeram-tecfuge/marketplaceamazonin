<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Amazon Vendor Partner -->
        <record id="partner_amazon_vendor" model="res.partner">
            <field name="name">Amazon Sellers</field>
            <field name="supplier_rank">1</field>
            <field name="is_company">True</field>
        </record>

        <!-- Default Amazon Settlement Clearing Account (COA) -->
        <record id="account_amazon_clearing" model="account.account">
            <field name="name">Amazone</field>
            <field name="code">1221</field>
            <field name="account_type">liability_current</field>
            <field name="reconcile">True</field>
        </record>

        <!-- Default Amazon Service Fee Product for Vendor Bills -->
        <record id="product_amazon_service_fee" model="product.product">
            <field name="name">Amazon Service Fee</field>
            <field name="type">service</field>
            <field name="default_code">AMZ-FEE</field>
        </record>
    </data>
</odoo>
