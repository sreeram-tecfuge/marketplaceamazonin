<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amazon_csv_import_wizard_form" model="ir.ui.view">
        <field name="name">amazon.csv.import.wizard.form</field>
        <field name="model">amazon.csv.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Amazon CSV/Excel File">
                <field name="state" invisible="1"/>
                
                <!-- State 1: File Selection -->
                <div invisible="state != 'upload'">
                    <group>
                        <field name="filename" invisible="1"/>
                        <field name="file_data" filename="filename" string="Select Amazon CSV/Excel File"/>
                    </group>
                    <p class="text-muted">
                        Note: Only records with Transaction Type <b>Shipment</b> and <b>Refund</b> will be imported. Duplicate records matching existing Order ID &amp; Invoice Number will be automatically skipped to prevent double entry.
                    </p>
                </div>

                <!-- State 2: Results & Duplicate Log -->
                <div invisible="state != 'result'">
                    <div class="alert alert-success d-flex align-items-center justify-content-between mb-3" role="alert">
                        <div>
                            <h5 class="alert-heading mb-1"><i class="fa fa-check-circle me-2"></i> CSV Import Complete</h5>
                            <span>Below is the execution summary and duplicate skip report.</span>
                        </div>
                        <span class="badge bg-white text-success border rounded-pill px-3 py-2 fs-6">
                            Batch: <field name="import_batch_id" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                    <group col="4">
                        <field name="import_batch_id" readonly="1"/>
                        <field name="total_rows" readonly="1"/>
                        <field name="imported_count" readonly="1"/>
                        <field name="duplicate_count" readonly="1"/>
                        <field name="ignored_count" readonly="1"/>
                    </group>
                    <separator string="Duplicate &amp; Error Log"/>
                    <field name="log_details" readonly="1" nolabel="1" style="font-family: monospace; width: 100%; min-height: 260px; background-color: #f8fafc; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; margin-top: 8px;"/>
                </div>

                <footer>
                    <button name="action_import" string="Upload &amp; Process" type="object" class="btn-primary" invisible="state != 'upload'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_amazon_csv_import_wizard" model="ir.actions.act_window">
        <field name="name">Upload Amazon File</field>
        <field name="res_model">amazon.csv.import.wizard</field>
        <field name="views" eval="[(False, 'form')]"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
