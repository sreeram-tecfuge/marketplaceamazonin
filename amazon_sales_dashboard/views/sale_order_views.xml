<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_amazon" model="ir.ui.view">
        <field name="name">sale.order.form.amazon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="amazon_order_id" readonly="1"/>
                <field name="amazon_shipment_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree_amazon" model="ir.ui.view">
        <field name="name">sale.order.tree.amazon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="amazon_order_id" optional="show"/>
                <field name="amazon_shipment_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
