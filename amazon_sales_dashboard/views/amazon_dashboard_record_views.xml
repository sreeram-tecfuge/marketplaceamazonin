<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View displaying all granular fields in wizard/dialog or detail mode -->
    <record id="view_amazon_dashboard_record_form" model="ir.ui.view">
        <field name="name">amazon.dashboard.record.form</field>
        <field name="model">amazon.dashboard.record</field>
        <field name="arch" type="xml">
            <form string="Amazon Transaction Details">
                <header>
                    <button name="action_create_sale_order" string="Create Sale Order" type="object" class="btn-primary" invisible="transaction_type != 'Shipment' or state == 'so_created'"/>
                    <button name="action_create_refund" string="Create Refund" type="object" class="btn-warning" invisible="transaction_type != 'Refund' or state == 'refund_created'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,so_created,refund_created,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="transaction_type" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="invoice_number" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                            <field name="order_date" readonly="1"/>
                            <field name="seller_gstin" readonly="1"/>
                        </group>
                        <group string="Shipment &amp; Refund Details">
                            <field name="shipment_id" readonly="1"/>
                            <field name="shipment_date" readonly="1"/>
                            <field name="shipment_item_id" readonly="1"/>
                            <field name="credit_note_no" readonly="1" invisible="transaction_type != 'Refund'"/>
                            <field name="credit_note_date" readonly="1" invisible="transaction_type != 'Refund'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Product Information">
                            <group>
                                <group>
                                    <field name="sku" readonly="1"/>
                                    <field name="item_description" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="asin" readonly="1"/>
                                    <field name="hsn_sac" readonly="1"/>
                                    <field name="product_tax_code" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Address Information">
                            <group>
                                <group string="Bill From">
                                    <field name="bill_from_city" readonly="1"/>
                                    <field name="bill_from_state" readonly="1"/>
                                    <field name="bill_from" readonly="1"/>
                                </group>
                                <group string="Ship From">
                                    <field name="ship_from_city" readonly="1"/>
                                    <field name="ship_from_state" readonly="1"/>
                                    <field name="ship_from" readonly="1"/>
                                </group>
                            </group>
                            <group string="Ship To">
                                <group>
                                    <field name="ship_to_city" readonly="1"/>
                                    <field name="ship_to_state" readonly="1"/>
                                    <field name="ship_to" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Tax Breakdown &amp; Financials">
                            <group>
                                <group string="Amounts">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="tax_exclusive_gross" readonly="1"/>
                                    <field name="total_tax_amount" readonly="1"/>
                                    <field name="invoice_amount" readonly="1"/>
                                    <field name="principal_amount" readonly="1"/>
                                    <field name="principal_amount_basis" readonly="1"/>
                                </group>
                                <group string="GST Taxes">
                                    <field name="cgst_rate" readonly="1"/>
                                    <field name="cgst_tax" readonly="1"/>
                                    <field name="sgst_rate" readonly="1"/>
                                    <field name="sgst_tax" readonly="1"/>
                                    <field name="igst_rate" readonly="1"/>
                                    <field name="igst_tax" readonly="1"/>
                                    <field name="utgst_rate" readonly="1"/>
                                    <field name="utgst_tax" readonly="1"/>
                                </group>
                            </group>
                            <group string="TCS Details">
                                <group>
                                    <field name="tcs_cgst_rate" readonly="1"/>
                                    <field name="tcs_cgst_amount" readonly="1"/>
                                    <field name="tcs_sgst_rate" readonly="1"/>
                                    <field name="tcs_sgst_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="tcs_igst_rate" readonly="1"/>
                                    <field name="tcs_igst_amount" readonly="1"/>
                                    <field name="tcs_utgst_rate" readonly="1"/>
                                    <field name="tcs_utgst_amount" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Generated Odoo Documents">
                            <group>
                                <group>
                                    <field name="sale_order_id" readonly="1"/>
                                    <field name="picking_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="refund_move_id" readonly="1"/>
                                </group>
                            </group>
                            <field name="error_message" readonly="1" invisible="not error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shipment Data List View (Basic Main Columns) -->
    <record id="view_amazon_dashboard_shipment_tree" model="ir.ui.view">
        <field name="name">amazon.dashboard.shipment.tree</field>
        <field name="model">amazon.dashboard.record</field>
        <field name="arch" type="xml">
            <list string="Shipment Data" decoration-info="state=='draft'" decoration-success="state=='so_created'" decoration-danger="state=='error'">
                <header>
                    <button name="%(action_amazon_csv_import_wizard)d" string="Upload Excel/CSV File" type="action" class="btn-primary" icon="fa-upload"/>
                    <button name="action_bulk_create_sale_orders" string="Create Sale Orders" type="object" class="btn-success" icon="fa-cogs"/>
                </header>
                <field name="order_id" string="Order ID"/>
                <field name="invoice_number" string="Invoice No"/>
                <field name="order_date" string="Order Date"/>
                <field name="sku" string="SKU"/>
                <field name="quantity" string="Qty"/>
                <field name="tax_exclusive_gross" string="Price Excl. Tax"/>
                <field name="total_tax_amount" string="Tax"/>
                <field name="invoice_amount" string="Invoice Total"/>
                <field name="ship_to" string="Ship To"/>
                <field name="state" string="Status" widget="badge" decoration-info="state=='draft'" decoration-success="state=='so_created'" decoration-danger="state=='error'"/>
                <button name="action_create_sale_order" string="Create Sale Order" type="object" icon="fa-check-circle" class="btn-sm btn-primary" invisible="state != 'draft'"/>
                <button name="action_open_record_wizard" string="Inspect Details" type="object" icon="fa-eye" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <!-- Refund Data List View (Basic Main Columns) -->
    <record id="view_amazon_dashboard_refund_tree" model="ir.ui.view">
        <field name="name">amazon.dashboard.refund.tree</field>
        <field name="model">amazon.dashboard.record</field>
        <field name="arch" type="xml">
            <list string="Refund Data" decoration-warning="state=='draft'" decoration-success="state=='refund_created'" decoration-danger="state=='error'">
                <header>
                    <button name="%(action_amazon_csv_import_wizard)d" string="Upload Excel/CSV File" type="action" class="btn-primary" icon="fa-upload"/>
                    <button name="action_bulk_create_refunds" string="Create Refunds" type="object" class="btn-warning" icon="fa-undo"/>
                </header>
                <field name="order_id" string="Order ID"/>
                <field name="invoice_number" string="Invoice No"/>
                <field name="credit_note_no" string="Credit Note No"/>
                <field name="credit_note_date" string="Credit Note Date"/>
                <field name="sku" string="SKU"/>
                <field name="quantity" string="Qty"/>
                <field name="tax_exclusive_gross" string="Price Excl. Tax"/>
                <field name="total_tax_amount" string="Tax"/>
                <field name="invoice_amount" string="Invoice Total"/>
                <field name="ship_to" string="Ship To"/>
                <field name="state" string="Status" widget="badge" decoration-warning="state=='draft'" decoration-success="state=='refund_created'" decoration-danger="state=='error'"/>
                <button name="action_create_refund" string="Refund" type="object" icon="fa-undo" class="btn-sm btn-warning" invisible="state != 'draft'"/>
                <button name="action_open_record_wizard" string="Inspect Details" type="object" icon="fa-eye" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <!-- Search View with Filters -->
    <record id="view_amazon_dashboard_record_search" model="ir.ui.view">
        <field name="name">amazon.dashboard.record.search</field>
        <field name="model">amazon.dashboard.record</field>
        <field name="arch" type="xml">
            <search string="Search Amazon Transactions">
                <field name="order_id"/>
                <field name="invoice_number"/>
                <field name="shipment_id"/>
                <field name="sku"/>
                <field name="asin"/>
                <field name="credit_note_no"/>
                <filter string="Shipments" name="filter_shipment" domain="[('transaction_type', '=', 'Shipment')]"/>
                <filter string="Refunds" name="filter_refund" domain="[('transaction_type', '=', 'Refund')]"/>
                <separator/>
                <filter string="Pending Process" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="filter_done" domain="[('state', 'in', ('so_created', 'refund_created'))]"/>
                <filter string="Error" name="filter_error" domain="[('state', '=', 'error')]"/>
                <group>
                    <filter string="Transaction Type" name="groupby_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="SKU" name="groupby_sku" context="{'group_by': 'sku'}"/>
                    <filter string="Order Date" name="groupby_order_date" context="{'group_by': 'order_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action: Shipment Data Dashboard Section -->
    <record id="action_amazon_dashboard_shipment" model="ir.actions.act_window">
        <field name="name">Shipment Data Dashboard</field>
        <field name="res_model">amazon.dashboard.record</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('transaction_type', '=', 'Shipment')]</field>
        <field name="context">{'default_transaction_type': 'Shipment', 'search_default_filter_shipment': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_amazon_dashboard_shipment_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_amazon_dashboard_record_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Amazon Shipment records found.
            </p>
            <p>
                Click <b>Upload Excel/CSV File</b> at the top to import Amazon transactions.
            </p>
        </field>
    </record>

    <!-- Window Action: Refund Data Dashboard Section -->
    <record id="action_amazon_dashboard_refund" model="ir.actions.act_window">
        <field name="name">Refund Data Dashboard</field>
        <field name="res_model">amazon.dashboard.record</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('transaction_type', '=', 'Refund')]</field>
        <field name="context">{'default_transaction_type': 'Refund', 'search_default_filter_refund': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_amazon_dashboard_refund_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_amazon_dashboard_record_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Amazon Refund records found.
            </p>
            <p>
                Click <b>Upload Excel/CSV File</b> at the top to import Amazon transactions.
            </p>
        </field>
    </record>

    <!-- Window Action: All Transactions Dashboard -->
    <record id="action_amazon_dashboard_all" model="ir.actions.act_window">
        <field name="name">Amazon All Dashboard Data</field>
        <field name="res_model">amazon.dashboard.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amazon_dashboard_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Amazon transaction records found.
            </p>
        </field>
    </record>

    <!-- Dynamic OWL JS Client Action: Latest Upload Only -->
    <record id="action_amazon_dashboard_client" model="ir.actions.client">
        <field name="name">Amazon Sales Dashboard</field>
        <field name="tag">amazon_dashboard_main_action</field>
    </record>

    <!-- Dynamic OWL JS Client Action: All Historical Data -->
    <record id="action_amazon_dashboard_all_client" model="ir.actions.client">
        <field name="name">Amazon All Sales Dashboard</field>
        <field name="tag">amazon_dashboard_all_action</field>
    </record>
</odoo>
