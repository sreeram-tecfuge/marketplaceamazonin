<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-Level Application Menu -->
    <menuitem id="menu_amazon_dashboard_root"
              name="Amazon Sales &amp; Payments"
              web_icon="amazon_sales_dashboard,static/description/icon.png"
              sequence="15"/>

    <!-- ========================================== -->
    <!-- MENU 1: SALES & ORDERS (CURRENT SALES IMPORT) -->
    <!-- ========================================== -->
    <menuitem id="menu_amazon_sales_section"
              name="Sales &amp; Orders"
              parent="menu_amazon_dashboard_root"
              sequence="10"/>

    <menuitem id="menu_amazon_dashboard_main_client"
              name="Latest Sales Dashboard"
              parent="menu_amazon_sales_section"
              action="action_amazon_dashboard_client"
              sequence="1"/>

    <menuitem id="menu_amazon_dashboard_all_client"
              name="All Sales Dashboard"
              parent="menu_amazon_sales_section"
              action="action_amazon_dashboard_all_client"
              sequence="2"/>

    <menuitem id="menu_amazon_dashboard_shipment"
              name="Shipment Data List"
              parent="menu_amazon_sales_section"
              action="action_amazon_dashboard_shipment"
              sequence="10"/>

    <menuitem id="menu_amazon_dashboard_refund"
              name="Refund Data List"
              parent="menu_amazon_sales_section"
              action="action_amazon_dashboard_refund"
              sequence="11"/>

    <menuitem id="menu_amazon_dashboard_all"
              name="All Raw Sales Transactions"
              parent="menu_amazon_sales_section"
              action="action_amazon_dashboard_all"
              sequence="12"/>

    <menuitem id="menu_amazon_dashboard_upload"
              name="Upload Sales Excel/CSV"
              parent="menu_amazon_sales_section"
              action="action_amazon_csv_import_wizard"
              sequence="20"/>

    <!-- ========================================== -->
    <!-- MENU 2: PAYMENT SETTLEMENTS (PAYMENT IMPORT) -->
    <!-- ========================================== -->
    <menuitem id="menu_amazon_payment_section"
              name="Payment Settlements"
              parent="menu_amazon_dashboard_root"
              sequence="20"/>

    <menuitem id="menu_amazon_payment_dashboard_main"
              name="Payment Settlement Dashboard"
              parent="menu_amazon_payment_section"
              action="action_amazon_payment_dashboard_client"
              sequence="1"/>

    <menuitem id="menu_amazon_payment_record_list"
              name="Payment Settlement Data List"
              parent="menu_amazon_payment_section"
              action="action_amazon_payment_record_all"
              sequence="10"/>

    <menuitem id="menu_amazon_payment_upload"
              name="Upload Payment Excel/CSV"
              parent="menu_amazon_payment_section"
              action="action_amazon_payment_import_wizard"
              sequence="20"/>
</odoo>
